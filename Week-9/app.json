{
  "expo": {
    "name": "RoomCheck Week 9",
    "slug": "roomcheck-week9",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1a56db"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.roomcheck.week9"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1a56db"
      },
      "package": "com.roomcheck.week9",
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.HIGH_SAMPLING_RATE_SENSORS"
      ]
    },
    "plugins": [
      [
        "expo-sensors",
        {
          "motionPermission": "Izinkan RoomCheck mengakses sensor gerak untuk fitur dashboard sensor."
        }
      ],
      "expo-secure-store",
      "expo-status-bar"
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
